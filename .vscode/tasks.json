{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Build tests",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build_cpp_tests.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "C++: Run tests",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\run_cpp_tests.ps1"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "C++: Run tests with Clang",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\run_clang_tests.ps1"
            ],
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "C++: Run tests with AddressSanitizer",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\run_cpp_tests.ps1",
                "-AddressSanitizer"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Python: Build module",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build_python_module.ps1"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Python: Run tests",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\run_python_tests.ps1"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "MyString: Clean",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\clean.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "MyString: Clean rebuild and run all",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\rebuild_all.ps1"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "MyString: Run all checks",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\run_all.ps1"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
